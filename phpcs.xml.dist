<?xml version="1.0"?>
<ruleset name="metatavu-wordpress-iac">
	<description>WordPress coding standards and PHPCompatibility for PHP 8.4 and later (plugin doc D15).</description>

	<file>metatavu-wordpress-iac.php</file>
	<file>metatavu-wordpress-iac/plugin.php</file>
	<file>metatavu-wordpress-iac/src</file>
	<file>tests</file>

	<arg name="extensions" value="php"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg value="sp"/>

	<config name="testVersion" value="8.4-"/>
	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<!-- Tests build tokens and keys by hand and stub WordPress. -->
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
</ruleset>
